# ============================================================
# DeineZeit – Konfigurationsvorlage
# Kopieren nach: .env
# ACHTUNG: .env niemals in Git committen!
# ============================================================

# ── Datenbank ────────────────────────────────────────────────
DB_USER=deinezeit
DB_PASSWORD=BITTE_AENDERN_sicheres_passwort_min_16_zeichen
DB_NAME=deinezeit

# ── Backend-Sicherheit ───────────────────────────────────────
# Zufälligen Schlüssel generieren:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BITTE_AENDERN_zufaelliger_schluessel_min_64_zeichen

# ── Ersteinrichtung ──────────────────────────────────────────
# Schützt den Einrichtungs-Assistenten (/setup) bis zum ersten Benutzer:
# Ohne diesen Token könnte jeder, der die frische Installation vor Ihnen
# aufruft, sich zum Administrator machen. install.sh erzeugt ihn selbst.
# Zufälligen Token generieren:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
SETUP_TOKEN=BITTE_AENDERN_einrichtungs_token

# ── Domain & URLs ────────────────────────────────────────────
DOMAIN=deine-domain.at
FRONTEND_URL=https://deine-domain.at

# ── App-Modus ────────────────────────────────────────────────
# "production" → API-Docs deaktiviert, optimiert
# "development" → API-Docs unter /api/docs erreichbar
APP_ENV=production

# ── Datenbank-Verbindungen (optional) ────────────────────────
# Wie viele Verbindungen das Backend zur Datenbank offen hält.
# Jede gleichzeitig bearbeitete Anfrage belegt eine; ist alles belegt,
# warten weitere Anfragen und laufen nach 30 Sekunden in einen Fehler.
# PostgreSQL verträgt in der Standardeinstellung 100 insgesamt.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Arbeitsprozesse (optional) ───────────────────────────────
# BITTE AUF 1 LASSEN. Die Hintergrund-Worker (Mail-Scan, wiederkehrende
# Rechnungen, Fälligkeit, Postecke, Backup, SSL) laufen als Threads im
# App-Prozess — bei mehreren Prozessen liefen sie doppelt (doppelte
# Rechnungsentwürfe, doppelte Backups). Erhöhen erst, wenn die Worker einen
# prozessübergreifenden Riegel haben.
UVICORN_WORKERS=1

# ── Anfragebremse (optional) ─────────────────────────────────
# Begrenzt, wie viele Anfragen eine Adresse pro Minute stellen darf
# (200 allgemein, 10 Anmeldeversuche). Schützt vor dem Durchprobieren
# von Passwörtern.
# NUR für Messläufe (Lasttest) auf false setzen — ein Lasttest kommt von
# einer einzigen Adresse und liefe sonst gegen die Bremse statt gegen die
# Anwendung. Im Betrieb bleibt das auf true.
RATE_LIMIT_AKTIV=true

# ── Zeitzone (optional) ──────────────────────────────────────
# Ortszeit der Installation. Bestimmt, welcher Kalendertag „heute" ist
# (Belegdatum, Fälligkeit, Nummernkreis-Jahr), die Uhrzeit auf Ausdrucken
# und wann die nächtlichen Automatiken (Backup, Wiederkehr) laufen.
# Die Container selbst laufen in UTC; ohne diese Angabe bekäme ein um
# 23:30 ausgestellter Beleg das Datum des Vortags.
TZ=Europe/Vienna

# ── Protokolltiefe (optional) ────────────────────────────────
# Steuert, wie gesprächig das Backend im Docker-Log ist.
# INFO (Vorgabe) zeigt u.a. die Diagnose-Zeilen der KI-Anbindung:
#   docker compose logs backend | grep '\[KI-'
# WARNING = nur Warnungen und Fehler, DEBUG = alles.
LOG_LEVEL=INFO

# ── Backup-Sicherheit ────────────────────────────────────────
# Zufälligen Token generieren:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
BACKUP_PING_TOKEN=BITTE_AENDERN_backup_token
# Zeitlimit für pg_dump beim Backup (Sekunden). Vorgabe 600; erhöhen, wenn
# die Datenbank groß ist und „Backup-Timeout" gemeldet wird.
BACKUP_TIMEOUT_SEKUNDEN=600

# ── WebAuthn / Passkeys (optional) ──────────────────────────
WEBAUTHN_RP_ID=deine-domain.at
WEBAUTHN_RP_NAME=DeineZeit

# ── Datei-Speicher (MinIO) ───────────────────────────────────
# Zufällige Zugangsdaten generieren:
#   python3 -c "import secrets; print(secrets.token_hex(8))"
MINIO_ROOT_USER=BITTE_AENDERN_minio_user
MINIO_ROOT_PASSWORD=BITTE_AENDERN_minio_passwort_min_8_zeichen

# ── Let's Encrypt (SSL-Zertifikate) ─────────────────────────
ADMIN_EMAIL=admin@deine-domain.at
